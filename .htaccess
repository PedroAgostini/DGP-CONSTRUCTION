# DGP Construction | Apache config (Hostinger)
# Production: https://dgpconstructionusa.com

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------- anti-spam ----------
  # WordPress brute-force and XML-RPC spam probes (this site has no WordPress)
  RewriteRule ^(wp-login\.php|wp-admin|xmlrpc\.php|wp-content|wp-includes) - [F,L,NC]
  # requests with no user agent are almost always scripts
  RewriteCond %{HTTP_USER_AGENT} ^-?$
  RewriteRule ^ - [F,L]

  # ---------- one canonical address: https, no www ----------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # serve /index.html as /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # block dotfiles and project notes if they ever get uploaded
  # (.well-known stays open: Hostinger uses it to issue the SSL certificate)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(md|json|log|csv)$ - [F,L,NC]
</IfModule>

# ---------- security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
  AddCharset utf-8 .html .css .js .txt .xml .webmanifest
</IfModule>

# ---------- compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml application/manifest+json text/plain image/x-icon
</IfModule>

# ---------- browser caching ----------
# HTML, CSS and JS revalidate on every visit (files are not versioned), so updates show up right away.
# Fonts, icons and images are long-lived.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
